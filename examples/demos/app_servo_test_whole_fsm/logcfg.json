                      "Whisker1.Barometer2_2",
                      "Whisker1.Barometer2_3"],
        "headers": ["whisker2_1", "whisker2_2", "whisker2_3"]
    },

    "PreWhisker1":{
        "name": "PreWhisker1",
        "type": "CF",
        "period": 20,
        "variables": ["app.PreprocessWhisker1_1",
                      "app.PreprocessWhisker1_2",
                      "app.PreprocessWhisker1_3"],
        "headers": ["prewhisker1_1", "prewhisker1_2", "prewhisker1_3"]
    },

    "PreWhisker2":{
        "name": "PreWhisker2",
        "type": "CF",
        "period": 20,
        "variables": ["app.PreprocessWhisker2_1",
                      "app.PreprocessWhisker2_2",
                      "app.PreprocessWhisker2_3"],
        "headers": ["prewhisker2_1", "prewhisker2_2", "prewhisker2_3"]
    },

    "MLPOUTPUT":{
        "name": "MLPOUTPUT",
        "type": "CF",
        "period": 20,
        "variables": ["app.MlpOutput1",
                      "app.MlpOutput2"],
        "headers": ["MLPwhisker1", "MLPwhisker2"]
    },

    "KFOUTPUT":{
        "name": "KFOUTPUT",
        "type": "CF",
        "period": 20,
        "variables": ["app.KFMlpOutput1",
                      "app.KFMlpOutput2"],
        "headers": ["KFwhisker1","KFwhisker2"]
    },

    "GPISLABEL":{
        "name": "GPISLABEL",
        "type": "CF",
        "period": 20,
        "variables": ["app.GpisLabel"],
        "headers": ["gpislabel"]
    },


    "StateOuterLoop":{
        "name": "StateOuterLoop",
        "type": "CF",
        "period": 20,
        "variables": ["app.stateOuterLoop"],
        "headers": ["stateouterloop"]
    },

    "StateInnerLoop":{
        "name": "StateInnerLoop",
        "type": "CF",
        "period": 20,
        "variables": ["app.stateInnerLoop"],
        "headers": ["stateinnerloop"]
    },

    "cmd":{
        "name": "cmd",
        "type": "CF",
        "period": 20,
        "variables": ["app.cmdVelX",
                      "app.cmdVelY",
                      "app.cmdAngWDeg"],
        "headers": ["cmdx","cmdy","cmdyaw"]
    },


    "orientation":{
        "name": "orientation",
        "type": "CF",
        "period": 20,
        "variables": ["stabilizer.yaw"],
        "headers": ["yaw"]
    },

    "flow":{
        "name": "flow",
        "type": "CF",
        "period": 20,
        "variables": ["motion.deltaX",
                      "motion.deltaY"],
        "headers": ["flowX", "flowY"]
    },
    
    "laser":{
        "name": "laser",
        "type": "CF",
        "period": 20,
        "variables": ["range.front"],
        "headers": ["laserFront"]
    },

    "kalman":{
        "name": "kalman",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.stateX",
                      "kalman.stateY",
                      "kalman.stateZ",
                      "kalman.statePX",
                      "kalman.statePY",
                      "kalman.statePZ"],
        "headers": ["kalX", "kalY", "kalZ", "kalPX", "kalPY", "kalPZ"]
    },

    "acc":{
        "name": "acc",
        "type": "CF",
        "period": 20,
        "variables": ["acc.x",
                      "acc.y",
                      "acc.z"],
        "headers": ["accx", "accy", "accz"]
    },


    "otpos":{
        "name": "otpos",
        "type": "CF",
        "period": 20,
        "variables": ["locSrv.x",
                      "locSrv.y",
                      "locSrv.z"],
        "headers": ["otX", "otY", "otZ"]
    },


    "mocap": {
        "name": "mocap",
        "type": "EXT",
        "period": 20,
        "variables": ["pos_x", "pos_y", "yaw"],
        "headers": ["Position X", "Position Y", "yaw"]
    },

    "traj": {
        "name": "traj",
        "type": "CF",
        "period": 20,
        "variables": ["traj.traj_x", "traj.traj_y"],
        "headers": ["trajx", "trajy"]
    },

    "whisker1_withtemp": {
        "name": "whisker1_withtemp",
        "type": "CF",
        "period": 20,
        "variables": ["Whisker.Barometer1_1",
                      "Whisker.Barometer1_2",
                      "Whisker.Barometer1_3",
                      "Whisker.Temperature1_1",
                      "Whisker.Temperature1_2",
                      "Whisker.Temperature1_3"],
        "headers": ["whisker1_1", "whisker1_2", "whisker1_3", "temp1_1", "temp1_2", "temp1_3"]
    },

    "mission": {
        "name": "mission",
        "type": "CF",
        "period": 20,
        "variables": [
            "mission.state",
            "mission.trajIndex",
            "mission.cmdA",
            "mission.cmdB",
            "mission.cmdHeight",
            "mission.contact"
        ],
        "headers": [
            "mission_state",
            "traj_index",
            "cmdA",
            "cmdB",
            "cmdHeight",
            "contact"
        ]
    },
    "mission_nd": {
        "name": "mission_nd",
        "type": "CF",
        "period": 20,
        "variables": [
            "mission.noDynVx",
            "mission.noDynVy",
            "mission.noDynSpeed"
        ],
        "headers": [
            "noDynVx",
            "noDynVy",
            "noDynSpeed"
        ]
    }
}



