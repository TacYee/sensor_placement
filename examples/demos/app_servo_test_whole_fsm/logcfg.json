        "name": "F",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.fx",
                      "kalman.fy",
                      "kalman.friction"],
        "headers": ["fx", "fy", "friction"]
    },
    
    "whisker1":{
        "name": "whisker1",
        "type": "CF",
        "period": 20,
        "variables": ["Whisker.Barometer1_1",
