{

    "attitude":{
        "name": "attitude",
        "type": "CF",
        "period": 20,
        "variables": ["stabilizer.roll",
                      "stabilizer.pitch",
                      "stabilizer.yaw"],
        "headers": ["roll", "pitch", "yaw"]
    },

    "motor":{
        "name": "motor",
        "type": "CF",
        "period": 20,
        "variables": ["motor.m1",
                      "motor.m2",
                      "motor.m3",
                      "motor.m4"
                      ],
        "headers": ["motor1", "motor2", "motor3", "motor4"]
    },

    "state":{
        "name": "state",
        "type": "CF",
        "period": 20,
        "variables": ["stateEstimate.x",
                      "stateEstimate.y",
                      "stateEstimate.z",
                      "stateEstimate.vx",
                      "stateEstimate.vy"],
        "headers": ["stateX", "stateY", "stateZ", "stateVX", "stateVY"]
    },

    "state_kf":{
        "name": "state_kf",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.stateX",
                      "kalman.stateY",
                      "kalman.statePX",
                      "kalman.statePY"],
        "headers": ["stateX_kf", "stateY_kf", "stateVX_kf", "stateVY_kf"]
    },

    "state_wo":{
        "name": "state_wo",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.stateX_wo",
                      "kalman.stateY_wo"],
        "headers": ["stateX_wo", "stateY_wo"]
    },

    "state_wf":{
        "name": "state_wf",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.stateX_wf",
                      "kalman.stateY_wf",
                      "kalman.statePX_wf",
                      "kalman.statePY_wf"],
        "headers": ["stateX_wf", "stateY_wf", "statevX_wf", "statevY_wf"]
    },

        "state_wof":{
        "name": "state_wof",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.stateX_wof",
                      "kalman.stateY_wof",
                      "kalman.statePX_wof",
                      "kalman.statePY_wof"],
        "headers": ["stateX_wof", "stateY_wof", "statevX_wof", "statevY_wof"]
    },

    "kalman_nodynamics": {
    "name": "kalman_nodynamics",
    "type": "CF",
    "period": 20,
    "variables": [
        "kalman.stateX_noDyn",
        "kalman.stateY_noDyn",
        "kalman.statePX_noDyn",
        "kalman.statePY_noDyn",
        "kalman.statePZ_noDyn"
    ],
    "headers": [
        "stateX_noDyn",
        "stateY_noDyn",
        "statePX_noDyn",
        "statePY_noDyn",
        "statePZ_noDyn"
    ]
    },

    "var":{
        "name": "var",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.varX",
                      "kalman.varY",
                      "kalman.varPX",
                      "kalman.varPY"],
        "headers": ["var_x", "var_y", "var_vx", "var_vy"]
    },
  
    "var_wf":{
        "name": "var_wf",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.varX_wf",
                      "kalman.varY_wf",
                      "kalman.varPX_wf",
                      "kalman.varPY_wf"],
        "headers": ["var_x_wf", "var_y_wf", "var_vx_wf", "var_vy_wf"]
    },

    "K":{
        "name": "K",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.K_px",
                      "kalman.K_py"],
        "headers": ["K_px", "K_py"]
    },

    "K_wf":{
        "name": "K_wf",
        "type": "CF",
        "period": 20,
        "variables": ["kalman.K_px_wf",
                      "kalman.K_py_wf"],
        "headers": ["K_px_wf", "K_py_wf"]
    },
    

